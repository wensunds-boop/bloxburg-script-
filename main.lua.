local function buildTab(name, order)
    local btn = new("TextButton", {
        Size = UDim2.new(0, 0, 1, -8),
        BackgroundColor3 = C.panel,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        LayoutOrder = order,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        TextColor3 = C.dim,
        Text = name,
    }, tabBar)
    local pad = new("UIPadding", {
        PaddingLeft = UDim.new(0, 14),
        PaddingRight = UDim.new(0, 14),
    }, btn)
    new("UISizeConstraint", { MinSize = Vector2.new(0, 0) }, btn)
    local w = #name * 7 + 30
    btn.Size = UDim2.new(0, w, 1, -8)
    corner(btn, 7)

    local page = new("ScrollingFrame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = C.stroke,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
    }, content)
    new("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 10),
    }, page)
    new("UIPadding", { PaddingBottom = UDim.new(0, 14) }, page)

    pages[name] = page
    tabButtons[name] = btn

    track(btn.MouseButton1Click:Connect(function()
        for other, p in pairs(pages) do
            p.Visible = (other == name)
            tw(tabButtons[other], 0.14, {
                BackgroundColor3 = other == name and C.card or C.panel,
                TextColor3 = other == name and C.text or C.dim,
            })
        end
    end))
    return btn, page
end

