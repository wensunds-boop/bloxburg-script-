    track(pill.MouseButton1Click:Connect(function()
        on = not on
        render(true)
        if cfg.onChanged then cfg.onChanged(on) end
    end))

    return {
        get = function() return on end,
        set = function(v) on = v and true or false; render(false) end,
        row = row,
    }
