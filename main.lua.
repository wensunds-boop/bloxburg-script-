--=====================================================================
-- ZONE ENGINE
--=====================================================================
local function zoneLimitAt(pos)
    if not state.limits.enabled then return nil end
    for _, zone in ipairs(state.limits.zones) do
        local mn, mx = zone.min, zone.max
        if pos.X >= math.min(mn.X, mx.X) and pos.X <= math.max(mn.X, mx.X)
            and pos.Y >= math.min(mn.Y, mx.Y) and pos.Y <= math.max(mn.Y, mx.Y)
            and pos.Z >= math.min(mn.Z, mx.Z) and pos.Z <= math.max(mn.Z, mx.Z) then
            return zone.limit
        end
    end
    return state.limits.global
end

--=====================================================================
-- PLAYER ENGINE
--=====================================================================
local function applyPlayer(dt)
    local hum = getHumanoid()
    if not hum or hum.Health <= 0 then return end

    local root = getRoot()
    local limit = root and zoneLimitAt(root.Position) or nil
    local target = state.player.speed
    if limit then target = math.min(target, limit) end

    if state.player.enabled then
        if math.abs(hum.WalkSpeed - target) > 0.05 then
            pcall(function() hum.WalkSpeed = target end)
        end
    end

    if state.player.jumpEnabled then
        pcall(function()
            hum.UseJumpPower = true
            if math.abs(hum.JumpPower - state.player.jump) > 0.05 then
                hum.JumpPower = state.player.jump
            end
        end)
    end

    local updater = _G.__VeniceSpeedSuite and _G.__VeniceSpeedSuite.updatePlayerReadout
    if updater then updater(hum.WalkSpeed, limit) end
end

--=====================================================================
-- VEHICLE ENGINE
--=====================================================================
local function getVehicle()
    local hum = getHumanoid()
    if not hum or not hum.SeatPart then return nil end
    local seat = hum.SeatPart
    local model = seat:FindFirstAncestorOfClass("Model")
    if not model then return nil end
    -- climb to the outermost model (the whole car)
    while model.Parent and model.Parent ~= workspace do
        local up = model.Parent:FindFirstAncestorOfClass("Model")
        if not up then break end
        model = up
    end
    return model, seat
end

local assistState = {
    mode = "detect",
    timer = 0,
    seat = nil,
}

local function applyVehicle(dt)
    local model, seat = getVehicle()

    if not model then
        assistState.mode = "detect"
        assistState.timer = 0
        assistState.seat = nil
        local updater = _G.__VeniceSpeedSuite and _G.__VeniceSpeedSuite.updateVehicleReadout
        if updater then updater(nil, 0) end
        return
    end

    if assistState.seat ~= seat then
        assistState.seat = seat
        assistState.mode = "detect"
        assistState.timer = 0
    end

    local primary = model.PrimaryPart
    if not primary then
        for _, d in ipairs(model:GetDescendants()) do
            if d:IsA("BasePart") then primary = d; break end
        end
    end

    local velocity = primary and primary.AssemblyLinearVelocity or Vector3.zero
    local speed = velocity.Magnitude

    local updater = _G.__VeniceSpeedSuite and _G.__VeniceSpeedSuite.updateVehicleReadout

    if not state.vehicle.enabled then
        if updater then updater(model.Name, speed) end
        return
    end

    -- 1. property writes (cheap, often overwritten by the car's script)
    pcall(function()
        for _, d in ipairs(model:GetDescendants()) do
            if d:IsA("VehicleSeat") then
                d.MaxSpeed = state.vehicle.maxSpeed
                d.MaxTorque = math.max(60000, state.vehicle.maxSpeed * 1400)
            end
        end
        model:SetAttribute("MaxSpeed", state.vehicle.maxSpeed)
        if seat:IsA("VehicleSeat") then
            seat:SetAttribute("MaxSpeed", state.vehicle.maxSpeed)
        end
    end)

    if not state.vehicle.assist or not primary then
        if updater then updater(model.Name, speed) end
        return
    end

    -- 2. velocity assist
    local throttle = 0
    if seat:IsA("VehicleSeat") then
        local ok, raw = pcall(function() return seat.ThrottleFloat end)
        if ok and type(raw) == "number" then throttle = raw end
    end

    assistState.timer += dt
    if throttle ~= 0 then
        assistState.mode = "throttle"
    elseif assistState.mode == "detect" and assistState.timer > 1.2 and speed < 2 then
        assistState.mode = "hold"
    end

    local forward = primary.CFrame.LookVector
    local forwardSpeed = velocity:Dot(forward)
    local desired

    if assistState.mode == "throttle" then
        desired = throttle * state.vehicle.maxSpeed
    else
        desired = math.clamp(forwardSpeed, -state.vehicle.maxSpeed, state.vehicle.maxSpeed)
    end

    local increasing = math.abs(desired) > math.abs(forwardSpeed)
    local rate = increasing and state.vehicle.accel or state.vehicle.brake
    local step = math.clamp(desired - forwardSpeed, -rate * dt, rate * dt)
    local newForward = forwardSpeed + step

    local newVelocity = forward * newForward + Vector3.new(0, velocity.Y, 0)
    pcall(function() primary.AssemblyLinearVelocity = newVelocity end)

    if updater then updater(model.Name, speed, assistState.mode) end
end

