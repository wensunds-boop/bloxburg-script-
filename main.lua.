local CONFIG_FILE = "VeniceSpeedSuite.json"

local DEFAULTS = {
    player  = { enabled = false, speed = 34, jumpEnabled = false, jump = 50 },
    vehicle = { enabled = false, maxSpeed = 130, accel = 110, brake = 190, assist = true },
    limits  = { enabled = false, global = 110, zones = {} },
    ui      = { accent = Color3.fromRGB(94, 141, 255), keybind = Enum.KeyCode.K },
}

local function deepCopy(t)
    local out = {}
    for k, v in pairs(t) do
        out[k] = type(v) == "table" and deepCopy(v) or v
    end
    return out
end

local state = deepCopy(DEFAULTS)

local hasFS = pcall(function() return writefile ~= nil end)

local function loadConfig()
    if not hasFS then return end
    local ok, raw = pcall(function() return readfile(CONFIG_FILE) end)
    if not ok or type(raw) ~= "string" or #raw < 2 then return end
    local ok2, data = pcall(function() return HttpService:JSONDecode(raw) end)
    if not ok2 or type(data) ~= "table" then return end
    for section, values in pairs(DEFAULTS) do
        if type(data[section]) == "table" then
            for key, def in pairs(values) do
                local v = data[section][key]
                if type(v) == type(def) then
                    state[section][key] = v
                elseif typeof and typeof(def) == "Color3" and type(v) == "table" then
                    local okc, c = pcall(Color3.fromRGB, v[1], v[2], v[3])
                    if okc then state[section][key] = c end
                end
            end
        end
    end
    if type(state.limits.zones) == "table" then
        local clean = {}
        for _, z in ipairs(state.limits.zones) do
            if type(z) == "table" and z.min and z.max and z.limit then
                table.insert(clean, z)
            end
        end
        state.limits.zones = clean
    else
        state.limits.zones = {}
    end
end

local saveToken = 0
local function saveConfig()
    if not hasFS then return end
    saveToken += 1
    local myToken = saveToken
    task.delay(0.6, function()
        if myToken ~= saveToken then return end
        local ok, encoded = pcall(function() return HttpService:JSONEncode(state) end)
        if ok then pcall(writefile, CONFIG_FILE, encoded) end
    end)
end

loadConfig()

--=====================================================================
-- BOOKKEEPING
--=====================================================================
local connections = {}
local function track(c)
    table.insert(connections, c)
    return c
end

local accentTargets = {}
local function acc(inst, prop)
    table.insert(accentTargets, { inst = inst, prop = prop })
    return inst
end

local function teardown()
    for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
    table.clear(connections)
    if _G.__VeniceSpeedSuite and _G.__VeniceSpeedSuite.gui then
        pcall(function() _G.__VeniceSpeedSuite.gui:Destroy() end)
    end
    _G.__VeniceSpeedSuite = nil
end

